    {
      "cell_type": "code",
      "source": [
        "# Prepare each dataset split for classification\n",
        "\n",
        "def prepare_split(df, method_name):\n",
        "    human = pd.DataFrame({\n",
        "        \"text\": df[\"original_abstract\"],\n",
        "        \"label\": \"Human\",\n",
        "        \"generation_method\": method_name\n",
        "    })\n",
        "\n",
        "    ai_columns = [\n",
        "        \"allam_generated_abstract\",\n",
        "        \"jais_generated_abstract\",\n",
        "        \"llama_generated_abstract\",\n",
        "        \"openai_generated_abstract\"\n",
        "    ]\n",
        "\n",
        "    ai_parts = []\n",
        "\n",
        "    for column in ai_columns:\n",
        "        temp = pd.DataFrame({\n",
        "            \"text\": df[column],\n",
        "            \"label\": \"AI\",\n",
        "            \"generation_method\": method_name\n",
        "        })\n",
        "        ai_parts.append(temp)\n",
        "\n",
        "    ai = pd.concat(ai_parts, ignore_index=True)\n",
        "\n",
        "    return pd.concat([human, ai], ignore_index=True)"
      ],
